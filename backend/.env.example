# Copy to backend/.env and adjust. Never commit .env.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://bettingvalue:bettingvalue@localhost:5432/bettingvalue
CORS_ORIGINS=http://localhost:3000

# The Odds API (https://the-odds-api.com) - optional. Without a key, use `python -m app.cli sync-demo`.
ODDS_API_KEY=
ODDS_API_REGIONS=uk,eu
ODDS_API_MARKETS=h2h,totals,spreads

# Prices not re-confirmed by a sync within this many minutes are ignored (treated as withdrawn).
ODDS_STALE_AFTER_MINUTES=360
# Bookmakers that must price a complete market before a consensus fair price is computed.
VALUE_MIN_BOOKS=3
